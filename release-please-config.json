{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "packages": {
    "skills/agent-dispatch": {
      "component": "agent-dispatch-skill",
      "extra-files": [
        {
          "type": "generic",
          "path": "SKILL.md"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='agent-dispatch')].version"
        }
      ]
    },
    "skills/imgen": {
      "component": "imgen-skill",
      "extra-files": [
        {
          "type": "generic",
          "path": "SKILL.md"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='imgen')].version"
        }
      ]
    },
    "tools/imgen": {
      "component": "imgen",
      "extra-files": [
        {
          "type": "generic",
          "path": "tool.yaml"
        },
        {
          "type": "generic",
          "path": "cli/build.zig.zon"
        }
      ]
    }
  }
}
